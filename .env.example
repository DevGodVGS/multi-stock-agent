# Telegram Alerts Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional LLM Configuration
# Priority: claude_code (auto-detected if on PATH) > anthropic > openai
# Set LLM_PROVIDER to force one: claude_code | anthropic | openai
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App Branding & Settings
BRAND=ArthaAgent
CONFIDENCE_THRESHOLD=7
SHORTLIST_PER_BUCKET=4
AGENT_DELAY=0.4
PORT=5001
